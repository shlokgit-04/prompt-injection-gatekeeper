# --- AWS: credentials for the Strands agent's main LLM (Amazon Bedrock) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# AWS credentials are resolved from the standard chain (env vars, ~/.aws, IAM role).
# Never put an access key in this file or in git.

# --- Strands Decider 2B server (start it with scripts/run_decider.sh) ---
STRANDS_DECIDER_URL=http://127.0.0.1:8099

# --- send_email tool: leave SMTP_HOST empty for demo mode (mail lands in ./data/outbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Paths ---
DATA_DIR=./data
DOCUMENTS_DIR=./demo/documents
